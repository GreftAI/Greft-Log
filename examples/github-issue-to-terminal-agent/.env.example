GREFT_API_URL=https://greft-relay-783768789695.us-central1.run.app
GREFT_API_KEY=YOUR_GREFT_PROJECT_API_KEY

# The existing terminal agent's address that should receive issue handoffs.
# Must already exist in the same Greft project as the API key above.
TERMINAL_AGENT_ADDRESS=@triage

# OpenRouter is used to turn the raw issue into a short, structured brief.
# Leave OPENROUTER_API_KEY empty to fall back to a deterministic pass-through
# summary (no LLM call).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Normally supplied by GitHub Actions automatically for a manual test run;
# set these yourself when running main.py locally.
GITHUB_ISSUE_TITLE=Example: login form accepts an invalid email address
GITHUB_ISSUE_BODY=Steps to reproduce: ...
GITHUB_ISSUE_URL=https://github.com/GreftAI/Greft-Log/issues/1
GITHUB_ISSUE_NUMBER=1
GITHUB_REPOSITORY=GreftAI/Greft-Log
